name: Build Gifscythe

on:
  push:
  pull_request:

# S34 (the owner's call): one run per branch and event, and no push run that the pull request already
# covers.
#  - concurrency: a newer push to the same branch (or PR) cancels the older run of the same event, so a
#    quick follow-up commit does not pay for a Windows build nobody will read. A push to main is never
#    cancelled and never replaces another (its group is the run id): every main commit keeps its proof.
#  - the `gate` job skips a push run when an open, mergeable PR exists for the branch - the PR's own
#    pull_request run tests that commit. Before a PR exists, and for a PR with merge conflicts (GitHub
#    starts no pull_request run for those), the push run still runs: CI on a bare branch is the
#    feedback loop the agent sessions work in.
concurrency:
  group: ${{ github.ref == 'refs/heads/main' && format('main-{0}', github.run_id) || format('build-{0}-{1}', github.event_name, github.head_ref || github.ref) }}
  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}

# Runner images (N-34, the owner's call, S34): ubuntu-24.04 is pinned in every Linux job (gate, docs,
# linux, portability) instead of ubuntu-latest. GitHub moves that label from Ubuntu 24.04 to 26.04
# gradually between 2026-10-19 and 2026-11-19 (changelog 2026-09-17); the linux job installs Qt with apt
# and runs the offscreen GUI harness, so an image change could turn it red with no change in this repo -
# the N-26 confusion again. To move to 26.04 on purpose: change the four labels together and trial the
# change on a branch first.

jobs:
  # Decides whether this run does the work (see the concurrency note above). It never fails the run:
  # every job below runs when the gate says "run", when it errors, and when it is cancelled-free.
  gate:
    name: gate (dedupe push vs PR runs)
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      pull-requests: read
    outputs:
      skip: ${{ steps.decide.outputs.skip }}
    steps:
      - uses: actions/checkout@v4
        with:
          sparse-checkout: working_code/gifscythe/scripts/ci_gate.sh
          sparse-checkout-cone-mode: false

      - name: Decide (scripts/ci_gate.sh; table in tests/test_ci_gate.py)
        id: decide
        env:
          GH_TOKEN: ${{ github.token }}
          EVENT: ${{ github.event_name }}
          REF: ${{ github.ref }}
          BRANCH: ${{ github.ref_name }}
          REPO: ${{ github.repository }}
          OWNER: ${{ github.repository_owner }}
        run: bash working_code/gifscythe/scripts/ci_gate.sh

  # The documentation status gate used to be step 7 of the linux job. A red gate
  # skipped everything after it - the web suites, the oracle, the Qt GUI harness
  # and the packaging steps (main run 36960880593: six verification steps skipped
  # by one failed date comparison) - so CI could not tell "the docs are stale"
  # from "the code is broken". It is its own job now: a doc failure is named as
  # such and masks nothing, and it reports in about a minute instead of after the
  # whole linux build.
  #
  # Full history on purpose (fetch-depth: 0). A depth-1 checkout made G11 compare
  # the log date with the CHECKOUT's own date (the tip looks like it adds every
  # file) and made G10 skip on every branch and PR run, so main went red the day
  # after each log entry while the same tree was green on its PR (N-26 / N-31).
  # With history the gate measures what the local pre-push hook measures.
  docs:
    needs: gate
    if: ${{ !cancelled() && needs.gate.outputs.skip != 'true' }}
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # The gate re-measures the unit-suite RUNTIME count (G9b needs the built
      # binary) and G15 needs the git-hook bootstrap that build.sh performs. No
      # Qt here: without Qt6 the gate takes its stricter branch in which harness
      # counts must be labelled as past measurements (G9c) - the same branch a
      # developer sandbox takes.
      - name: Build engine, CLI and unit tests (the gate re-measures them)
        working-directory: working_code/gifscythe
        run: ./build.sh

      # The docs are the context the next session starts from, so a stale
      # STATUS.md is corrupted input rather than a cosmetic problem. This gate
      # regenerates the status register from the repo and diffs it against the
      # committed one, so a hand-fudged roll-up cannot pass. --no-gate-run keeps
      # it from re-running verify_audit.sh, whose build/package/web steps the
      # linux and windows jobs already run (the same reason the whole of
      # verify_audit.sh is deliberately not a CI step).
      - name: Documentation status gate (STATUS.md register)
        working-directory: working_code/gifscythe
        run: ./scripts/check_docs.sh --no-gate-run

  linux:
    needs: gate
    if: ${{ !cancelled() && needs.gate.outputs.skip != 'true' }}
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4

      - name: Install Qt6
        run: sudo apt-get update && sudo apt-get install -y qt6-base-dev

      - name: Build engine, CLI, tests, and GUI
        working-directory: working_code/gifscythe
        run: ./build.sh --all

      - name: Engine pipeline tests
        working-directory: working_code/gifscythe
        run: ./scripts/test_engine.sh

      - name: CLI smoke tests
        working-directory: working_code/gifscythe
        run: ./scripts/smoke_cli.sh

      # U-71 / P2-17 (F:NF-14). run_argv()'s Windows branch returned `code & 0xff`, so an
      # NTSTATUS whose low byte is zero - 0xC0000100 among them - came back as exit 0: a crash
      # reported as SUCCESS, the top false-success class this repo audits for. The mask rule is a
      # pure function (classify_windows_exit_code, no Win32 types), so its proof runs HERE too and
      # not only on the windows job, whose log these sandboxes cannot read. Three legs: S1 sentinel
      # (the old mask must be absent), S2 semantic (an 11-row table plus the whole
      # 0xC0000000..0xC000FFFF band delivers no 0 for a non-zero raw code), S3 mutation (the same
      # probe with the old mask reintroduced MUST fail - a mutant that passes means the table has
      # no teeth). The LLP64 leg, where `long` really is 4 bytes, is the `portability` job below.
      - name: Windows exit-code classifier proof (U-71 / P2-17)
        working-directory: working_code/gifscythe
        run: ./scripts/test_u71_exit_codes.sh

      # The documentation status gate is the separate `docs` job above (S34): as
      # a step here, one doc failure skipped every verification step below it.

      # The web/ demo ships a SECOND copy of the command builder and the
      # validation rules. Nothing in the C++ suites touches them, so without
      # these two the JS and C++ sides drift silently (audit U-03 proved they
      # do). They need only the CLI built above plus the Node on the runner.
      # S34: every suite runs even if an earlier one failed, and a failing suite is NAMED. The job log
      # is unreadable from the agent sessions (Actions log blobs are blocked) and check-run annotations
      # are not, so the first red of this step - a startup-banner race in server-bounds, one run in
      # about fifteen - read only "exit code 1" and had to be found by reproducing it locally. The
      # step still fails if any suite fails.
      - name: Web JS/C++ parity + server regression tests
        run: |
          set -uo pipefail
          failed=""
          for t in command validate numeric-honesty transport body-limit static-hygiene request-guard device-names server-bounds stem; do
            if out="$(node "web/test/$t.test.mjs" 2>&1)"; then
              printf '%s\n' "$out" | tail -n 2
            else
              failed="$failed $t"
              printf '%s\n' "$out"
              msg="$(printf '%s\n' "$out" | grep -E -A3 --no-group-separator '^(FAIL|Error|AssertionError)|FAILED' | head -n 16 || true)"
              [ -n "$msg" ] || msg="$(printf '%s\n' "$out" | tail -n 12)"
              msg="${msg//'%'/'%25'}"
              msg="${msg//$'\r'/'%0D'}"
              msg="${msg//$'\n'/'%0A'}"
              echo "::error title=web suite $t failed::${msg}"
            fi
          done
          if [ -n "$failed" ]; then
            echo "failed suites:$failed"
            exit 1
          fi

      # U-57 / P1-37 (E:NA-05). The Emscripten module behind web/wasm is a SINGLETON, so its
      # virtual FS survived run to run: wasm.js wrote /in.gif, called callMain() and read /out.gif
      # unconditionally, so after one success an exit-0/no-write run served the PREVIOUS run's GIF
      # and reported success for the wrong input. Now both fixed paths are cleared BEFORE the call
      # and the read-back goes through an admission rule (exists, non-empty, GIF87a/GIF89a magic -
      # the same bar as the server's U-92 gate). Zero deps, no emcc, no browser: T1 replays the
      # ORIGINAL sequence against a fake MEMFS and asserts the audit's claim is real (the in-suite
      # RED leg - if T1 ever fails, the finding, not the fix, needs re-checking); T2..T5 prove the
      # replacement. Kept as its own step rather than folded into the parity loop above so a red
      # here names U-57 and not "web suite u57-stale-output" (S34).
      - name: WASM stale-output guard (U-57 / P1-37)
        run: node web/test/u57-stale-output.test.mjs

      - name: Seeded engine-oracle conformance (U-94 / P2-18)
        run: node working_code/gifscythe/scripts/oracle_fuzz.mjs --full

      # U-58 / P1-38 + U-72 / P1-42. Both patches in the S35 intake specify a source-level
      # sentinel; the 0005 one as written (`grep -c currentSettings()`) FALSE-FAILS on the
      # fix's own comment - MainWindow.cpp's continuation comment names currentSettings()
      # to say what must NOT run there - so it was never wired in. This script is that
      # sentinel with a comment filter, plus the U-70 preview-boundary and U-72 latch
      # siblings, and it mutation-tests itself: S4 rebuilds every pre-fix shape (live
      # re-read in the continuation; the early `cancelling_ = false;` after the 3 s wait;
      # consume-after-verdict; a bare preview probe) and REQUIRES the checks to reject
      # them. Its own step so a red names the rows, not a suite (S34).
      - name: Qt source sentinels (U-58 batch snapshot, U-70 preview boundary, U-72 cancel latch)
        working-directory: working_code/gifscythe
        run: ./scripts/test_u58_u70_u72_sentinels.sh

      - name: GUI offscreen tests (COMPILED_AUDIT 6.B harness)
        timeout-minutes: 12
        working-directory: working_code/gifscythe
        run: |
          set -euo pipefail
          cmake -S . -B build-cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_GUI=ON
          cmake --build build-cmake -j2
          # The repo holds no image files (N-36): GS_TEST_REF_DIR is the harness's own hook for where logo.gif lives.
          # Capture the run and publish each FAIL line as an annotation: a harness that
          # dies on one assertion must name the case, not just exit 1 (S34's rule).
          log="${RUNNER_TEMP:-/tmp}/gui_offscreen.log"
          set +e
          GS_TEST_REF_DIR="$(./scripts/fixtures.sh)" QT_QPA_PLATFORM=offscreen ./build-cmake/test_gui_offscreen 2>&1 | tee "$log"
          status=${PIPESTATUS[0]}
          set -e
          if [ "$status" -ne 0 ]; then
            while IFS= read -r line; do echo "::error::$line"; done < <(grep -a 'FAIL' "$log" | head -20 || true)
            echo "::error::test_gui_offscreen exited $status (FAIL lines above; a crash prints none)"
          fi
          exit "$status"

      - name: Package portable
        working-directory: working_code/gifscythe
        run: ./scripts/package_portable.sh

      # Audit U-02/U-08/U-14: the packager used to exit 0 for a folder with no
      # application in it, and CI uploaded that folder without ever looking
      # inside — so a green build proved nothing about the release. These two
      # steps make the contents a gate.
      - name: Packaging negative tests (incomplete packages must fail)
        working-directory: working_code/gifscythe
        run: ./scripts/test_package.sh

      - name: Assert package manifest
        working-directory: working_code/gifscythe
        run: |
          set -euo pipefail
          version=$(grep -oE 'Current version:.*[0-9]+\.[0-9]+\.[0-9]+' VERSION.md \
            | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
          pkg="release/$version/Gifscythe"
          for f in gifsicle gifscythe-cli gifscythe LICENSE COPYING.gifsicle COPYING.ms-pl COPYING.lgplv3 COPYING.gplv3 QT_NOTICE.txt README.txt; do
            if [[ ! -s "$pkg/$f" ]]; then
              echo "FAIL: $pkg/$f is missing or empty" >&2
              ls -la "$pkg" >&2 || true
              exit 1
            fi
          done
          echo "package manifest OK"
          ls -la "$pkg"

      # OD-17: the product is Windows-only, so this job ships nothing. The
      # linux build/package/assert above stays as the automated test battery
      # for the shared logic (engine, CLI, GUI harness, stager).

  # S34 (the owner's call; N-30 and N-32): the two checks that need neither a Windows box nor emcc,
  # only zig - a pinned pip wheel that cross-compiles to every target below. A separate job, so it
  # runs beside the others: about 2 runner-minutes on Actions (run 36983286343: toolchain 8 s, the
  # 32-bit unit suite 69 s, the wasm bar 38 s), against about 4 minutes for the windows ->
  # csharp-spike chain, which is the longest path - so it adds no wall-clock time. Any non-zero
  # exit fails it, including a runner's "SKIPPED" exit 3 (and GS_REQUIRE_PROOF=1 below turns a
  # skipped Python suite into a failure): a skipped proof must never read as a passed one.
  portability:
    name: portability (32-bit long, wasm32 bar)
    needs: gate
    if: ${{ !cancelled() && needs.gate.outputs.skip != 'true' }}
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4

      # A venv: 24.04's system pip refuses to install into the system Python (PEP 668).
      - name: Install the pinned toolchain (zig, Pillow)
        run: |
          set -euo pipefail
          python3 -m venv "$RUNNER_TEMP/venv"
          "$RUNNER_TEMP/venv/bin/pip" install --quiet ziglang==0.16.0 pillow==12.3.0
          echo "$RUNNER_TEMP/venv/bin" >> "$GITHUB_PATH"
          "$RUNNER_TEMP/venv/bin/python" -m ziglang version
          node --version

      # N-30: Windows is LLP64 (`long` is 4 bytes) and is the only platform we ship, but the fast jobs
      # run on LP64 Linux. This builds the unit suite for x86-linux-musl, where `long` is 4 bytes, and
      # runs it: the bug that kept the Windows job red for 31 runs (a `long` integer probe) fails
      # here, in seconds, on a Linux runner. RED/GREEN evidence: STATUS N-30.
      - name: Unit suite on a 32-bit-long target (the N-30 class)
        working-directory: working_code/gifscythe
        run: ./scripts/test_unit_32bit_long.sh

      # U-71 / P2-17, the leg that actually matters for this finding. classify_windows_exit_code()
      # takes and prints an `unsigned long` - 8 bytes on this LP64 runner, 4 bytes on every platform
      # we ship - and its whole contract is about a raw code wider than one byte. Same trick as the
      # step above: x86-linux-musl is ILP32, so sizeof(long) == 4 and the binary still executes
      # here. test_u71_exit_codes.sh honours CXX with arguments, so the target rides in on the
      # compiler. A table that only ever ran with an 8-byte long would not have proved the Windows
      # shape at all.
      - name: Windows exit-code classifier on a 4-byte-long target (U-71, LLP64 width class)
        working-directory: working_code/gifscythe
        env:
          CXX: python3 -m ziglang c++ -target x86-linux-musl
        run: ./scripts/test_u71_exit_codes.sh

      # N-32, the owner's decision: the wasm track's bar is a SAME-LIBC native oracle. gifsicle's output
      # depends on libc qsort tie order and random(), so byte parity with the glibc build cannot pass;
      # what a wasm port can break is held to a musl-native build of the same sources instead. The
      # wasm32-wasi build runs under Node's WASI. --keep leaves the musl engine for the next step.
      - name: wasm32 engine == same-libc native engine, byte for byte (N-32 bar)
        run: python3 working_code/gifscythe/scripts/libc_parity/libc_parity.py --bar --keep "$RUNNER_TEMP/parity"

      # The Emscripten-side comparison (prove_wasm.mjs --oracle) can only run against a real emcc
      # build, which nothing here can make; this exercises its comparison logic with a fake module.
      - name: prove_wasm.mjs --oracle logic (fake module, real native engine)
        env:
          GS_TEST_ENGINE: ${{ runner.temp }}/parity/engine_musl
          GS_REQUIRE_PROOF: "1"   # a missing engine must fail this step, not skip ten tests and stay green
        run: python3 working_code/gifscythe/tests/test_prove_wasm_oracle.py

      - name: Bar verdict logic (a proof gate must be able to fail)
        run: python3 working_code/gifscythe/tests/test_libc_parity_bar.py

      # N-36: the repo holds no image files; the test images are text rebuilt by fixtures.sh. The first CI run of
      # that change failed on Windows (a CRLF checkout: GNU base64 -d rejects a CR) in steps whose logs nothing here
      # can read, so this suite reproduces a CRLF checkout offline and the Windows steps prove the real thing.
      - name: Text fixtures rebuild byte-identical images, from LF and from CRLF (N-36)
        run: python3 working_code/gifscythe/tests/test_fixtures.py

  windows:
    needs: gate
    if: ${{ !cancelled() && needs.gate.outputs.skip != 'true' }}
    runs-on: windows-latest
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v4

      - name: Install Qt6 (aqt) + MinGW toolchain
        id: provision
        run: |
          set -euo pipefail
          pip install aqtinstall
          aqt install-qt windows desktop 6.7.3 win64_mingw -O "$RUNNER_TEMP/qt"
          # MinGW from aqt tools (try common packages; ignore failures)
          aqt install-tool windows desktop tools_mingw1310 -O "$RUNNER_TEMP/qt" 2>/dev/null || \
          aqt install-tool windows desktop tools_mingw1120 -O "$RUNNER_TEMP/qt" 2>/dev/null || \
          aqt install-tool windows desktop tools_mingw90 -O "$RUNNER_TEMP/qt" 2>/dev/null || \
          choco install mingw -y --no-progress

          # Put every bin dir aqt created on PATH
          while IFS= read -r d; do
            echo "$d" >> "$GITHUB_PATH"
          done < <(find "$RUNNER_TEMP/qt" -type d -name bin 2>/dev/null)

          QT_BIN=$(echo "$RUNNER_TEMP/qt"/6.*/mingw_64/bin | awk '{print $1}')
          echo "QT_PREFIX=$(dirname "$QT_BIN")" >> "$GITHUB_ENV"
          echo "QT_BIN=$QT_BIN" >> "$GITHUB_ENV"
          echo "$QT_BIN" >> "$GITHUB_PATH"

      # Diagnostics only (S34, N-30): which compiler did the aqt fallback chain
      # (tools_mingw1310 -> 1120 -> 90 -> choco) actually leave first on PATH? The
      # job log is unreadable from the agent sandboxes, but check-run annotations
      # are, so the answer is also published as one notice. Never fails the job.
      - name: Toolchain identity (diagnostic only, never fails the job)
        if: ${{ !cancelled() }}
        continue-on-error: true
        run: |
          set +e
          gxx="$(command -v g++)"
          ver="$(g++ --version 2>&1 | head -n 1)"
          tgt="$(g++ -dumpmachine 2>&1 | head -n 1)"
          cm="$(command -v cmake >/dev/null 2>&1 && cmake --version 2>&1 | head -n 1 || echo 'cmake not on PATH')"
          nj="$(command -v ninja >/dev/null 2>&1 && ninja --version 2>&1 | head -n 1 || echo 'not on PATH')"
          all="$(which -a g++ 2>/dev/null | head -n 5 | tr '\n' ';')"
          echo "g++    : ${gxx:-<none on PATH>} :: ${ver}"
          echo "target : ${tgt}"
          echo "cmake  : ${cm}"
          echo "ninja  : ${nj}"
          echo "every g++ on PATH (first five): ${all}"
          echo "aqt tools:"; ls -1 "$RUNNER_TEMP/qt/Tools" 2>&1 | head -n 20
          echo "::notice title=Windows toolchain identity (N-30)::g++=${gxx:-none} | ${ver} | target ${tgt} | ${cm} | ninja ${nj} | on PATH: ${all}"

      - name: Build Windows engine (win32cfg.h)
        working-directory: working_code/gifscythe
        run: |
          set -euo pipefail
          # On windows-latest + MinGW, gcc produces PE binaries. If the
          # x86_64-w64-mingw32-gcc name is missing, alias it to gcc.
          if ! command -v x86_64-w64-mingw32-gcc >/dev/null 2>&1; then
            if command -v gcc >/dev/null 2>&1; then
              mkdir -p "$RUNNER_TEMP/shim"
              printf '#!/bin/bash\nexec gcc "$@"\n' > "$RUNNER_TEMP/shim/x86_64-w64-mingw32-gcc"
              chmod +x "$RUNNER_TEMP/shim/x86_64-w64-mingw32-gcc"
              export PATH="$RUNNER_TEMP/shim:$PATH"
            else
              echo "ERROR: no MinGW gcc on PATH" >&2
              exit 1
            fi
          fi
          ./scripts/build_engine.sh --windows
          ls -la release/*/gifsicle.exe

      - name: Build CLI + unit tests
        id: cli_tests
        working-directory: working_code/gifscythe
        run: |
          set -euo pipefail
          # build.sh syncs version.h, builds CLI+tests; skip GUI and skip re-building
          # the engine (already built as .exe above). Use a no-op engine step by
          # invoking the compile halves directly.
          version=$(grep -oE 'Current version:.*[0-9]+\.[0-9]+\.[0-9]+' VERSION.md \
            | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
          mkdir -p build
          printf '%s\n' \
            '#ifndef GIFSCYTHE_CORE_VERSION_H' \
            '#define GIFSCYTHE_CORE_VERSION_H' \
            "#define GS_VERSION \"$version\"" \
            "#define GS_VERSION_STR \"$version\"" \
            '#endif' > src/core/version.h
          # -static: artifacts must run on a clean Windows machine with no
          # MinGW runtime DLLs (libgcc_s_seh-1/libstdc++-6). Verified under
          # Wine 2026-09-07: dynamic exes die silently without those DLLs.
          g++ -std=c++17 -O2 -static -I src -o build/gifscythe-cli.exe src/cli/main.cpp
          g++ -std=c++17 -O2 -static -I src -o build/test_gifsicle_command.exe tests/test_gifsicle_command.cpp
          ./build/test_gifsicle_command.exe

      # U-71 / P2-17 on the platform the finding is about. This is the only runner where the raw
      # code really is a DWORD and `unsigned long` really is 4 bytes natively, and where
      # ProcessRunner.h compiles its _WIN32 branch - so the classifier is proven against the actual
      # Windows headers, not only against the portable shape of them. CXX is pinned to g++ because
      # MinGW ships no `c++` alias, which is the script's default.
      - name: Windows exit-code classifier proof, native (U-71 / P2-17)
        working-directory: working_code/gifscythe
        env:
          CXX: g++
        run: ./scripts/test_u71_exit_codes.sh

      # Diagnostics only (S34, N-30). Runs ONLY when the step above failed: re-runs
      # the same two compiles (and the unit exe if it linked) with their output
      # captured, probes S33's `-lstdc++fs` hypothesis, and publishes the tail as
      # an error annotation - the one channel of a failed run the agent sandboxes
      # can read. Original step untouched; this one never changes the job's result.
      - name: Diagnose CLI/unit-test build failure (diagnostic only)
        if: ${{ !cancelled() && steps.cli_tests.outcome == 'failure' }}
        continue-on-error: true
        working-directory: working_code/gifscythe
        run: |
          set +e
          out=build/diag_compile.log
          mkdir -p build
          echo "g++ $(g++ -dumpfullversion 2>&1 | head -n 1) ($(g++ -dumpmachine 2>&1 | head -n 1))" > "$out"
          run_logged() {
            echo "\$ $*" >> "$out"
            "$@" >> "$out" 2>&1
            rc=$?
            echo "[exit $rc]" >> "$out"
            return $rc
          }
          run_logged g++ -std=c++17 -O2 -static -I src -o build/diag_cli.exe src/cli/main.cpp
          run_logged g++ -std=c++17 -O2 -static -I src -o build/diag_unit.exe tests/test_gifsicle_command.cpp
          if [[ -f build/diag_unit.exe ]]; then
            echo "\$ run unit tests (last 25 lines)" >> "$out"
            ./build/diag_unit.exe 2>&1 | tail -n 25 >> "$out"
            echo "[exit ${PIPESTATUS[0]}]" >> "$out"
          fi
          echo "[probe: same CLI compile with -lstdc++fs appended]" >> "$out"
          run_logged g++ -std=c++17 -O2 -static -I src -o build/diag_cli_fs.exe src/cli/main.cpp -lstdc++fs
          cat "$out"
          msg="$(tail -c 3500 "$out")"
          msg="${msg//'%'/'%25'}"
          msg="${msg//$'\r'/'%0D'}"
          msg="${msg//$'\n'/'%0A'}"
          echo "::error title=CLI/unit-test build diagnostics (N-30)::${msg}"

      - name: Windows engine + CLI E2E smoke (native)
        working-directory: working_code/gifscythe
        run: |
          set -euo pipefail
          version=$(grep -oE 'Current version:.*[0-9]+\.[0-9]+\.[0-9]+' VERSION.md \
            | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
          ./release/$version/gifsicle.exe --version | head -1
          win_temp=$(cygpath -m "$RUNNER_TEMP" 2>/dev/null || echo "${RUNNER_TEMP//\//}")
          smoke="$win_temp/gs-smoke"
          mkdir -p "$smoke/my vacation"
          # The repo holds no image files (N-36): the upstream test images are rebuilt from text.
          fix="$(./scripts/fixtures.sh)"
          cp "$fix/logo.gif" "$smoke/in.gif"
          cp "$fix/logo1.gif" "$smoke/my vacation/b.gif"
          printf 'mode = auto\noptimize = 3\ninput = %s/in.gif\noutput = %s/out.gif\n' \
            "$smoke" "$smoke" > "$smoke/one.conf"
          printf 'mode = auto\noptimize = 2\ninput = %s/my vacation/b.gif\noutput = %s/my vacation/b_opt.gif\n' \
            "$smoke" "$smoke" > "$smoke/space.conf"
          ./build/gifscythe-cli.exe "$(cygpath -u "$smoke/one.conf" 2>/dev/null || echo "$smoke/one.conf")" --run \
            --engine "release/$version/gifsicle.exe"
          ./build/gifscythe-cli.exe "$(cygpath -u "$smoke/space.conf" 2>/dev/null || echo "$smoke/space.conf")" --run \
            --engine "release/$version/gifsicle.exe"
          ls -la "$smoke/out.gif" "$smoke/my vacation/b_opt.gif"
          # Missing engine must exit non-zero (U-B1 regression guard on Windows)
          if ./build/gifscythe-cli.exe "$smoke/one.conf" --run --engine "$smoke/nope.exe" >/dev/null 2>&1; then
            echo "FAIL: missing engine exited 0"; exit 1
          fi
          echo "Windows E2E smoke OK"

      # S34: independent of "Build CLI + unit tests". This CMake build compiles its
      # own copy of the CLI and tests, and the offscreen harness after it needs
      # only the engine from the step before - gating both on that step's success
      # hid the whole Windows GUI build and harness behind a CLI/unit-test red
      # for days (N-30). They still need the provisioning step: with no Qt
      # toolchain there is nothing to build.
      - name: Build GUI (CMake) + windeployqt
        id: gui_build
        if: ${{ !cancelled() && steps.provision.outcome == 'success' }}
        working-directory: working_code/gifscythe
        run: |
          set -euo pipefail
          # windows-latest cmake defaults to the Visual Studio generator,
          # which cannot consume the MinGW Qt packages aqt installed.
          # Force Ninja + the MinGW gcc/g++ that are on PATH.
          if ! cmake -S . -B build-win -G Ninja -DCMAKE_BUILD_TYPE=Release \
                -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++ \
                -DCMAKE_PREFIX_PATH="${QT_PREFIX}" \
                -DBUILD_GUI=ON; then
            cmake -S . -B build-win -G "MinGW Makefiles" -DCMAKE_BUILD_TYPE=Release \
                -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++ \
                -DCMAKE_PREFIX_PATH="${QT_PREFIX}" \
                -DBUILD_GUI=ON
          fi
          cmake --build build-win --config Release
          GUI_EXE=""
          for c in build-win/gifscythe.exe build-win/Release/gifscythe.exe build-win/Debug/gifscythe.exe; do
            if [[ -f "$c" ]]; then GUI_EXE="$c"; break; fi
          done
          if [[ -z "$GUI_EXE" ]]; then
            echo "ERROR: GUI executable not found after cmake build" >&2
            find build-win -name 'gifscythe*' -print || true
            exit 1
          fi
          if command -v windeployqt >/dev/null 2>&1; then
            windeployqt --release --no-translations "$GUI_EXE"
          fi
          version=$(grep -oE 'Current version:.*[0-9]+\.[0-9]+\.[0-9]+' VERSION.md \
            | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
          if [[ -f "release/$version/gifsicle.exe" ]]; then
            cp "release/$version/gifsicle.exe" "$(dirname "$GUI_EXE")/"
          fi
          # Also stage CLI next to GUI. An `if`, not `[[ ]] && cp`: as the last
          # command of the script a missing CLI made the && list exit 1 and failed
          # the whole GUI step for a reason unrelated to the GUI (the packaging
          # manifest assert further down still fails on a missing CLI).
          if [[ -f build/gifscythe-cli.exe ]]; then
            cp build/gifscythe-cli.exe "$(dirname "$GUI_EXE")/"
          fi

      - name: GUI offscreen tests (Windows)
        if: ${{ !cancelled() && steps.gui_build.outcome == 'success' }}
        timeout-minutes: 12
        working-directory: working_code/gifscythe
        run: |
          set -euo pipefail
          # Insurance: windeployqt ships qwindows.dll only; the harness runs
          # with QT_QPA_PLATFORM=offscreen, so stage the offscreen plugin
          # next to the exe as well (Qt install plugins dir also works, but
          # app-dir first removes any relocated-Qt path doubt).
          mkdir -p build-win/platforms
          cp "$QT_BIN/../plugins/platforms/qoffscreen.dll" build-win/platforms/ || true
          # The repo holds no image files (N-36): GS_TEST_REF_DIR is the harness's own hook for where logo.gif lives.
          # Capture the run and publish each FAIL line as an annotation: a harness that
          # dies on one assertion must name the case, not just exit 1 (S34's rule).
          log="${RUNNER_TEMP:-/tmp}/gui_offscreen.log"
          set +e
          GS_TEST_REF_DIR="$(cygpath -m "$(./scripts/fixtures.sh)")" QT_QPA_PLATFORM=offscreen ./build-win/test_gui_offscreen.exe 2>&1 | tee "$log"
          status=${PIPESTATUS[0]}
          set -e
          if [ "$status" -ne 0 ]; then
            while IFS= read -r line; do echo "::error::$line"; done < <(grep -a 'FAIL' "$log" | head -20 || true)
            echo "::error::test_gui_offscreen.exe exited $status (FAIL lines above; a crash prints none)"
          fi
          exit "$status"

      - name: Package portable (Windows)
        working-directory: working_code/gifscythe
        run: ./scripts/package_portable.sh --windows

      - name: Assert Windows package manifest
        working-directory: working_code/gifscythe
        run: |
          set -euo pipefail
          # OD-17: the Windows portable folder is the only shipped build, so
          # its manifest is a gate (mirrors the linux stager check, .exe names).
          version=$(grep -oE 'Current version:.*[0-9]+\.[0-9]+\.[0-9]+' VERSION.md \
            | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
          pkg="release/$version/Gifscythe"
          for f in gifsicle.exe gifscythe-cli.exe gifscythe.exe LICENSE COPYING.gifsicle COPYING.ms-pl COPYING.lgplv3 COPYING.gplv3 QT_NOTICE.txt README.txt; do
            if [[ ! -s "$pkg/$f" ]]; then
              echo "FAIL: $pkg/$f is missing or empty" >&2
              ls -la "$pkg" >&2 || true
              exit 1
            fi
          done
          echo "Windows package manifest OK"
          ls -la "$pkg"

      - name: Upload Windows artifacts
        uses: actions/upload-artifact@v4
        with:
          name: gifscythe-windows
          retention-days: 14
          path: |
            working_code/gifscythe/build/
            working_code/gifscythe/build-win/
            working_code/gifscythe/release/

  csharp-spike:
    # Phase 1 spike (S18): proves the dotnet toolchain, honest subprocess
    # semantics and self-contained single-file publish on real Windows.
    # Failing here is a valid, decision-grade outcome (see the C# plan).
    runs-on: windows-latest
    needs: windows
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v4

      - name: Set up .NET 9 SDK
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 9.0.x

      - name: Fetch Windows engine artifact
        uses: actions/download-artifact@v4
        with:
          name: gifscythe-windows
          path: spike-deps

      - name: Build spike
        run: dotnet build csharp/spike/spike.csproj -c Release

      - name: Spike stage files
        run: |
          set -euo pipefail
          # Never assume the artifact layout: find the engine wherever it rooted.
          engine=$(find spike-deps -name 'gifsicle.exe' -print -quit)
          [[ -n "$engine" && -s "$engine" ]] || { echo "FAIL: engine not in artifact" >&2; find spike-deps -maxdepth 6 >&2 || true; exit 1; }
          exe="csharp/spike/bin/Release/net9.0/gifscythe-spike.exe"
          [[ -x "$exe" ]] || { echo "FAIL: spike exe missing: $exe" >&2; exit 1; }
          work="$RUNNER_TEMP/spike"
          rm -rf "$work"; mkdir -p "$work/plain" "$work/vacación" "$work/日本語"
          # The repo holds no image files (N-36): the upstream test images are rebuilt from text.
          fix="$(bash working_code/gifscythe/scripts/fixtures.sh)"
          cp "$fix/logo.gif" "$work/plain/in.gif"
          cp "$fix/logo1.gif" "$work/vacación/résumé final.gif"
          cp "$fix/logo1.gif" "$work/日本語/入力.gif"
          printf 'not a gif\n' > "$work/plain/bad.gif"
          echo "SPIKE_ENGINE=$PWD/$engine" >> "$GITHUB_ENV"
          echo "SPIKE_EXE=$PWD/$exe" >> "$GITHUB_ENV"
          echo "SPIKE_WORK=$work" >> "$GITHUB_ENV"
          ls -la "$work/plain" "$work/vacación" "$work/日本語"
          echo "staged: engine=$engine exe=$exe"

      - name: Spike happy path is rc 0
        run: |
          set -euo pipefail
          set +e
          "$SPIKE_EXE" "$SPIKE_ENGINE" "$SPIKE_WORK/plain/in.gif" "$SPIKE_WORK/plain/out.gif" >"$SPIKE_WORK/happy.log" 2>&1
          rc=$?
          set -e
          cat "$SPIKE_WORK/happy.log"
          [[ "$rc" == 0 ]] || { echo "FAIL: want rc=0 got rc=$rc" >&2; exit 1; }
          [[ -s "$SPIKE_WORK/plain/out.gif" ]] || { echo "FAIL: out.gif missing/empty" >&2; exit 1; }
          echo OK

      - name: Spike latin path with space is rc 0
        run: |
          set -euo pipefail
          set +e
          "$SPIKE_EXE" "$SPIKE_ENGINE" "$SPIKE_WORK/vacación/résumé final.gif" "$SPIKE_WORK/vacación/salida O3.gif" >"$SPIKE_WORK/latin.log" 2>&1
          rc=$?
          set -e
          cat "$SPIKE_WORK/latin.log"
          [[ "$rc" == 0 ]] || { echo "FAIL: want rc=0 got rc=$rc" >&2; exit 1; }
          [[ -s "$SPIKE_WORK/vacación/salida O3.gif" ]] || { echo "FAIL: latin out missing/empty" >&2; exit 1; }
          echo OK

      - name: Spike CJK path fails honestly (engine ACP residual)
        run: |
          set -euo pipefail
          # Known product residual (src/core/WinUnicode.h): upstream gifsicle's
          # CRT parses argv in the system ACP, so CJK cannot reach the engine's
          # file APIs on stock Windows. The spike must FAIL LOUDLY here (rc!=0),
          # never silently succeed. If this ever goes rc=0, the residual has
          # closed - celebrate, then update WinUnicode.h and the C# plan.
          set +e
          "$SPIKE_EXE" "$SPIKE_ENGINE" "$SPIKE_WORK/日本語/入力.gif" "$SPIKE_WORK/日本語/出力.gif" >"$SPIKE_WORK/cjk.log" 2>&1
          rc=$?
          set -e
          cat "$SPIKE_WORK/cjk.log"
          [[ "$rc" != 0 ]] || { echo "FAIL: CJK unexpectedly rc=0 - residual closed? update WinUnicode.h + plan" >&2; exit 1; }
          echo "OK: CJK failed honestly with rc=$rc (engine ACP residual)"

      - name: Spike usage errors are rc 2
        run: |
          set -euo pipefail
          set +e
          "$SPIKE_EXE" >"$SPIKE_WORK/usage.log" 2>&1; rc1=$?
          "$SPIKE_EXE" "$SPIKE_ENGINE" "$SPIKE_WORK/plain/nope.gif" "$SPIKE_WORK/plain/x.gif" >>"$SPIKE_WORK/usage.log" 2>&1; rc2=$?
          set -e
          cat "$SPIKE_WORK/usage.log"
          [[ "$rc1" == 2 ]] || { echo "FAIL: no-args want rc=2 got $rc1" >&2; exit 1; }
          [[ "$rc2" == 2 ]] || { echo "FAIL: missing-input want rc=2 got $rc2" >&2; exit 1; }
          [[ ! -e "$SPIKE_WORK/plain/x.gif" ]] || { echo "FAIL: usage error wrote output" >&2; exit 1; }
          echo OK

      - name: Spike missing engine is rc 3
        run: |
          set -euo pipefail
          set +e
          "$SPIKE_EXE" "$SPIKE_WORK/nope.exe" "$SPIKE_WORK/plain/in.gif" "$SPIKE_WORK/plain/y.gif" >"$SPIKE_WORK/rc3.log" 2>&1
          rc=$?
          set -e
          cat "$SPIKE_WORK/rc3.log"
          [[ "$rc" == 3 ]] || { echo "FAIL: want rc=3 got rc=$rc" >&2; exit 1; }
          [[ ! -e "$SPIKE_WORK/plain/y.gif" ]] || { echo "FAIL: missing engine wrote output" >&2; exit 1; }
          echo OK

      - name: Spike bad input is rc 4
        run: |
          set -euo pipefail
          set +e
          "$SPIKE_EXE" "$SPIKE_ENGINE" "$SPIKE_WORK/plain/bad.gif" "$SPIKE_WORK/plain/z.gif" >"$SPIKE_WORK/rc4.log" 2>&1
          rc=$?
          set -e
          cat "$SPIKE_WORK/rc4.log"
          [[ "$rc" == 4 ]] || { echo "FAIL: want rc=4 got rc=$rc" >&2; exit 1; }
          echo OK

      - name: Spike lying engine without output is rc 5
        run: |
          set -euo pipefail
          # command -v finds the shell builtin; type -P forces a PATH search.
          tpath="$(type -P true || true)"
          [[ -n "$tpath" ]] || tpath=/usr/bin/true.exe
          trueexe="$(cygpath -w "$tpath")"
          [[ -x "$trueexe" ]] || { echo "FAIL: no runnable true.exe (tried $tpath)" >&2; exit 1; }
          set +e
          "$SPIKE_EXE" "$trueexe" "$SPIKE_WORK/plain/in.gif" "$SPIKE_WORK/plain/ghost.gif" >"$SPIKE_WORK/rc5a.log" 2>&1
          rc=$?
          set -e
          cat "$SPIKE_WORK/rc5a.log"
          [[ "$rc" == 5 ]] || { echo "FAIL: want rc=5 got rc=$rc" >&2; exit 1; }
          echo OK

      - name: Spike lying engine over stale output is rc 5
        run: |
          set -euo pipefail
          tpath="$(type -P true || true)"
          [[ -n "$tpath" ]] || tpath=/usr/bin/true.exe
          trueexe="$(cygpath -w "$tpath")"
          [[ -x "$trueexe" ]] || { echo "FAIL: no runnable true.exe (tried $tpath)" >&2; exit 1; }
          printf 'junk-bytes' > "$SPIKE_WORK/plain/stale.gif"
          set +e
          "$SPIKE_EXE" "$trueexe" "$SPIKE_WORK/plain/in.gif" "$SPIKE_WORK/plain/stale.gif" >"$SPIKE_WORK/rc5b.log" 2>&1
          rc=$?
          set -e
          cat "$SPIKE_WORK/rc5b.log"
          [[ "$rc" == 5 ]] || { echo "FAIL: want rc=5 got rc=$rc" >&2; exit 1; }
          echo OK

      - name: Publish self-contained single file
        run: |
          set -euo pipefail
          dotnet publish csharp/spike/spike.csproj -c Release -r win-x64 \
            --self-contained -p:PublishSingleFile=true -o csharp/spike/publish
          ls -la csharp/spike/publish
          exes=$(ls csharp/spike/publish/*.exe | wc -l | tr -d ' ')
          [[ "$exes" == 1 ]] || { echo "FAIL: want 1 exe, found $exes" >&2; exit 1; }
          size=$(stat -c%s csharp/spike/publish/gifscythe-spike.exe)
          [[ "$size" -ge 5000000 ]] || { echo "FAIL: exe too small for self-contained ($size B)" >&2; exit 1; }
          echo "single-file exe OK ($size bytes)"

      - name: Run published exe
        run: |
          set -euo pipefail
          work="$RUNNER_TEMP/spike-published"
          rm -rf "$work"; mkdir -p "$work"
          cp "$(bash working_code/gifscythe/scripts/fixtures.sh)/logo.gif" "$work/in.gif"
          engine=$(find spike-deps -name 'gifsicle.exe' -print -quit)
          [[ -n "$engine" && -s "$engine" ]] || { echo "FAIL: engine not in artifact" >&2; exit 1; }
          csharp/spike/publish/gifscythe-spike.exe \
            "$PWD/$engine" \
            "$work/in.gif" "$work/out.gif"
          [[ -s "$work/out.gif" ]]
          echo "published exe runs OK"

      - name: Upload spike artifact
        uses: actions/upload-artifact@v4
        with:
          name: gifscythe-spike
          retention-days: 14
          path: csharp/spike/publish/
