<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase-1 spike: throwaway-allowed. Pinned to .NET 9 (matches the
       ScreenToGif reference fork); self-containment is set at publish time
       by CI, not here. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gifscythe-spike</AssemblyName>
    <RootNamespace>Gifscythe.Spike</RootNamespace>
  </PropertyGroup>

</Project>
